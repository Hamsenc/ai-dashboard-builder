# GCP
GCP_PROJECT=surya-495408
GCP_REGION=asia-southeast1
BQ_APP_DATASET=12_data_agent_log
BQ_APP_TABLE_PREFIX=raw_dashboard_builder_
CATALOG_GCS_BUCKET=surya-495408-dashboard-builder-catalog

# Hàng rào cứng phạm vi dữ liệu: CHỈ các dataset này được phép đọc metadata/preview
# (app/datasource/bq_meta.assert_in_scope). Danh sách bảng + cột trong các dataset
# này đọc LIVE từ INFORMATION_SCHEMA mỗi request (cache 10 phút) — không phụ thuộc
# catalog_sync (Lark) chạy hằng ngày; catalog_sync giờ chỉ làm giàu tuỳ chọn (Purpose/
# Grain/Refresh/PII Note/KPI liên quan), lỗi đọc Lark KHÔNG làm sập app.
SERVING_DATASETS=00_serving_sales,00_serving_inventory,00_serving_operation

# Preview dữ liệu thật: BASE TABLE dùng tabledata.list (không tốn quota); VIEW phải
# chạy SELECT LIMIT qua BigQuery, giới hạn bytes riêng (nhỏ hơn hẳn BQ_MAX_BYTES_BILLED
# vì chỉ cần vài chục dòng).
PREVIEW_ROW_LIMIT=20
PREVIEW_MAX_BYTES=209715200

# Dashboard Embeds: host file HTML dashboard (AI sinh ra) để nhúng link vào Lark
# (public share-link, không cần đăng nhập để xem — chỉ upload mới cần whitelist).
EMBEDS_GCS_BUCKET=surya-495408-dashboard-builder-embeds
# Email (cách nhau bởi dấu phẩy) được phép upload dashboard mới. Để trống = không
# ai upload được (fail closed).
UPLOAD_WHITELIST_EMAILS=
EMBED_MAX_HTML_BYTES=2097152
EMBED_DATA_MAX_BYTES_BILLED=209715200
EMBED_DATA_CACHE_TTL_SECONDS=300

# LLM — dùng Claude Agent SDK (claude-agent-sdk), auth qua CLAUDE_CODE_OAUTH_TOKEN
# (sinh bằng `claude setup-token` trên máy có Claude Pro/Max/Team subscription),
# KHÔNG dùng ANTHROPIC_API_KEY (không tính theo pay-per-token API billing).
# CLI binary: Dockerfile sẽ npm install -g @anthropic-ai/claude-code, hoặc set
# CLAUDE_CLI_PATH trỏ thẳng vào binary nếu không có sẵn trên PATH.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_CLI_PATH=

# Lark
LARK_BASE_TOKEN=AcITbzsvraObhisDdQXlO6tggkd
LARK_TABLE_CATALOG_ID=tblA61jccZSexp2F
LARK_TABLE_KPI_ID=tblNr2LJO47ClgWW
LARK_APP_ID=
LARK_APP_SECRET=
# Xác nhận trước khi deploy thật: tenant Lark quốc tế (larksuite.com) hay Feishu
# (feishu.cn)? Ảnh hưởng host OAuth dùng ở app/auth/lark_oauth.py.
LARK_OAUTH_HOST=https://open.larksuite.com

# Session
SESSION_SECRET=

# Chỉ bật ở máy dev cục bộ. deploy.sh KHÔNG được set biến này — production luôn bắt
# buộc đăng nhập Lark thật, không có cửa hậu X-Dev-User.
ALLOW_DEV_USER_HEADER=true
